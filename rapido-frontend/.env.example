# ─────────────────────────────────────────────────────────────────────────────
# rapido-frontend environment variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend API URL ────────────────────────────────────────────────────────
# Only needed when deploying frontend separately to Vercel (without the backend).
# Set this to your deployed backend URL (Railway, Render, etc.)
# Leave empty when served together with Spring Boot on same origin.
VITE_API_URL=https://your-backend.up.railway.app

# ── Google OAuth Client ID ─────────────────────────────────────────────────
# Required to enable "Sign up / Login with Google" on the frontend.
#
# Steps to get a Client ID:
#  1. Go to https://console.cloud.google.com/
#  2. Create (or select) a project
#  3. APIs & Services → Credentials → Create Credentials → OAuth Client ID
#  4. Application type: Web application
#  5. Authorised JavaScript origins:
#       http://localhost:5173   (Vite dev)
#       http://localhost:3000   (CRA dev)
#       https://your-domain.com (production)
#  6. Copy the generated Client ID below
#
# Without this value the Google button is shown but clicking it will display
# an informational error instead of opening the Google popup.
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# ── Google Maps API Key ────────────────────────────────────────────────────
# Used for road distance calculation via Routes API v2 (computeRoutes).
# Free tier: 10,000 requests/month.
#
# Steps to get a key:
#  1. Go to https://console.cloud.google.com/
#  2. APIs & Services → Library → search "Routes API" → Enable
#  3. APIs & Services → Credentials → Create Credentials → API Key
#  4. Restrict the key to: Routes API
#
# If left blank, the app falls back to OSRM (free, open-source routing, no key).
VITE_GOOGLE_MAPS_KEY=YOUR_GOOGLE_MAPS_API_KEY
